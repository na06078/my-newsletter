# 비밀값 — 절대 올리지 않는다 (.env.example 만 예외)
.env
.env.*
!.env.example

# 가상환경·캐시
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 임시 파일
*.tmp

# 로컬 실행 캐시 — 기사 본문이 들어 있어(저작권·용량) 올리지 않는다
store/cache/

# 프로세스 간 실제 API 요청 예약 장부 — 재시작해도 보존하는 로컬 상태
store/호출예산.sqlite3*

# 라벨 위젯의 기본 생성본에는 일회성 로컬 제출 토큰이 들어간다
eval/label_widget.html
