# 비밀값 — 절대 올리지 않는다 (.env.example 만 예외)
.env
.env.*
!.env.example

# 가상환경·캐시
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 임시 파일
*.tmp

# 로컬 실행 캐시 — 기사 본문이 들어 있어(저작권·용량) 올리지 않는다
store/cache/

# 프로세스 간 실제 API 요청 예약 장부 — 재시작해도 보존하는 로컬 상태
store/호출예산.sqlite3*

# 새 표본의 라벨 위젯도 일회성 제출 토큰을 포함하므로 생성 HTML 전체를 제외한다
eval/**/*.html
